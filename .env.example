# Скопируй в .env на VPS и подставь свои значения.
# .env в git не попадает. В чат и в коммиты эти строки тоже не копируй.

# Токен от @BotFather. Выглядит как 123456789:AA...
TELEGRAM_BOT_TOKEN=

# Числовой id чата, куда бот пишет алерты. У лички это может быть отрицательное число.
TELEGRAM_CHAT_ID=

# Пароль админа Grafana. Задай свой, не оставляй пустым на VPS.
GF_SECURITY_ADMIN_PASSWORD=
